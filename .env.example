# Public values (safe for the browser). Set them in .env.local and in Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>

# LOCAL ONLY: used by scripts/create-user.mjs to create members.
# Never set this in Vercel and never commit it. The app does not read it.
SUPABASE_SECRET_KEY=<sb_secret_...>
