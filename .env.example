# Public values (safe for the browser). Set them in .env.local and in Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>

# Server only: needed to create users from the administrator panel.
# Set in .env.local and Vercel server environment. Never prefix with NEXT_PUBLIC_ or commit the value.
SUPABASE_SECRET_KEY=<sb_secret_...>
